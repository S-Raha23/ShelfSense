# Copy to .env and adjust. Read by docker-compose.yml (and by Django when running locally).

# --- Django -------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=false
# Comma-separated hostnames/IPs the site is served on (e.g. your EC2 public IP or domain)
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when serving over HTTPS on a custom domain, e.g. https://shelfsense.example.com
CSRF_TRUSTED_ORIGINS=
# Only needed if the React app is hosted on a different origin than the API
CORS_ALLOWED_ORIGINS=

# --- Database (PostgreSQL) ---------------------------------------------
POSTGRES_DB=shelfsense
POSTGRES_USER=shelfsense
POSTGRES_PASSWORD=change-me
# Point at Amazon RDS in production; the compose file builds this from the values above by default.
# DATABASE_URL=postgres://user:password@your-rds-endpoint:5432/shelfsense

# --- Marketplace integration -------------------------------------------
# mock   -> realistic simulated Amazon data (default)
# sp_api -> Amazon Selling Partner API adapter (requires SP_API_* credentials)
MARKETPLACE_CLIENT=mock
# Probability (0-1) that a mock API call fails with a simulated 429, to exercise retry logic
MOCK_FAILURE_RATE=0
SYNC_THROTTLE_RATE=20/hour

# Create the demo account (demo / shelfsense-demo) with data on startup
SEED_DEMO=true
